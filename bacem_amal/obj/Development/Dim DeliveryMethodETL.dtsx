                <property
                  dataType="System.String"
                  description="Spécifie le nom de l'objet de base de données utilisé pour ouvrir un ensemble de lignes."
                  name="OpenRowset">[dbo].[Dim DeliveryMethod]</property>
                <property
                  dataType="System.String"
                  description="Spécifie la variable contenant le nom de l'objet de base de données utilisé pour ouvrir un ensemble de lignes."
                  name="OpenRowsetVariable"></property>
                <property
                  dataType="System.String"
                  description="Commande SQL à exécuter."
                  name="SqlCommand"
                  UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor, Microsoft.DataTransformationServices.Controls, Version=17.0.0.0, Culture=neutral, PublicKeyToken=89845dcd8080cc91">MERGE INTO [dbo].[Dim DeliveryMethod] AS Target
USING (SELECT ? AS DeliveryMethodID, ? AS DeliveryMethodName) AS Source
ON Target.DeliveryMethodID = Source.DeliveryMethodID
WHEN MATCHED THEN
  UPDATE SET Target.DeliveryMethodName = Source.DeliveryMethodName
WHEN NOT MATCHED THEN
  INSERT (DeliveryMethodID, DeliveryMethodName) VALUES (Source.DeliveryMethodID, Source.DeliveryMethodName);</property>
                <property
                  dataType="System.Int32"
                  description="Spécifie la page de codes de la colonne à utiliser lorsque les informations de page de codes ne sont pas disponibles à partir de la source de données."
