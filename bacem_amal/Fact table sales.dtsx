                  dataType="System.String"
                  description="Commande SQL à exécuter."
                  name="SqlCommand"
                  UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor, Microsoft.DataTransformationServices.Controls, Version=17.0.0.0, Culture=neutral, PublicKeyToken=89845dcd8080cc91">SELECT 
    ol.OrderLineID AS OrderLineKey,
    o.CustomerID AS CustomerKey,
    ol.StockItemID AS StockItemKey,
 o.DeliveredByDeliveryMethod AS DeliveryMethodKey,
    CONVERT(INT, CONVERT(VARCHAR(8), o.OrderDate, 112)) AS DateKey,
    ol.Quantity,
    ol.UnitPrice,
    ol.TaxRate,
    (ol.Quantity * ol.UnitPrice * ol.TaxRate / 100.0) AS TaxAmount,
    (ol.Quantity * ol.UnitPrice * (1 + ol.TaxRate / 100.0)) AS TotalAmount,
    GETDATE() AS CreatedDate
FROM Sales.OrderLines ol
INNER JOIN Sales.Orders o ON ol.OrderID = o.OrderID
WHERE o.CustomerID IS NOT NULL</property>
                <property
